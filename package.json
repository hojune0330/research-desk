{
  "name": "jev-research-desk",
  "version": "0.2.0",
  "private": true,
  "description": "A Windows material library with local search and source-grounded OpenAI chat.",
  "main": "src/main.cjs",
  "author": "Research Desk contributors",
  "scripts": {
    "start": "electron .",
    "package:windows": "electron-builder --win portable nsis --x64 --publish never"
  },
  "dependencies": {
    "htmlparser2": "12.0.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.jevresearchdesk.desktop",
    "productName": "Research Desk",
    "directories": { "output": "portable-build" },
    "files": ["src/**/*", "package.json", "PRIVACY.md", "SECURITY.md", "THIRD_PARTY_NOTICES.md", "THIRD_PARTY_LICENSES.txt", "LICENSE"],
    "asar": true,
    "asarUnpack": ["src/extractor.cjs", "node_modules/**/*"],
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}, {"target": "nsis", "arch": ["x64"]}]
    },
    "portable": { "artifactName": "Research-Desk-${version}-portable-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "artifactName": "Research-Desk-${version}-setup-${arch}.${ext}" }
  }
}
